<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Solicitudes de Pago</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_approver'))]"/>
    </record>

    <!-- Regla: El solicitante SOLO ve sus propias solicitudes -->
    <record id="payment_request_rule_solicitante_own" model="ir.rule">
        <field name="name">Solicitudes de Pago: Solicitante ve solo las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <!-- Regla: Aprobadores y Tesorería ven todas las solicitudes de su compañía -->
    <record id="payment_request_rule_approver_all" model="ir.rule">
        <field name="name">Solicitudes de Pago: Aprobadores y Tesorería ven todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver')), (4, ref('group_payment_request_treasury'))]"/>
    </record>

    <!-- Tramo C: Regla Multi-Compañía -->
    <record id="payment_request_rule_company" model="ir.rule">
        <field name="name">Solicitudes de Pago: Multi-Compañía</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="payment_approval_level_rule_company" model="ir.rule">
        <field name="name">Niveles de Aprobación: Multi-Compañía</field>
        <field name="model_id" ref="model_payment_approval_level"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
